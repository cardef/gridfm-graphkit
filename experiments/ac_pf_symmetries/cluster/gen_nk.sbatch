#!/bin/bash
#SBATCH --job-name=symfm-nk
#SBATCH --partition=vicomtech
#SBATCH --account=di13
#SBATCH --qos=qos_di13
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=06:00:00
#SBATCH --array=0-5
#SBATCH --output=/gpfs/VICOMTECH/proiektuak/DI13/SYSTEMICO/SymmetricalFM/gridfm-graphkit/experiments/ac_pf_symmetries/cluster/logs/%x-%A_%a.out
# Piano K test sets (K0): case118_ieee with exactly k outages per scenario, k in 1 2 3 5 10 20 (array index), 2048
# scenarios each, generated by gridfm-datakit with the public set's recipe (cluster/nk/case118_k<k>.yaml; the grid
# file is cluster/nk/grids/case118_ieee.m = PGLib v23.07, because compute nodes cannot download it). Output moved to
# data/case118_nk<k>/raw, the layout graphkit expects. Compute nodes only: datakit's numpy does not start on the login VM.
#   sbatch gen_nk.sbatch
set -euo pipefail
S=/gpfs/VICOMTECH/proiektuak/DI13/SYSTEMICO
R=$S/SymmetricalFM/gridfm-graphkit
source $S/env/activate.sh $R
cd $R
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
KS=(1 2 3 5 10 20)
k=${KS[$SLURM_ARRAY_TASK_ID]}
cfg=experiments/ac_pf_symmetries/cluster/nk/case118_k$k.yaml
dst=data/case118_nk$k
[ -d "$dst/raw" ] && { echo "$dst/raw exists: skip"; exit 0; }
echo "HEAD $(git rev-parse HEAD) k=$k host=$(hostname) $(date -Is)"
sha1sum "$cfg" experiments/ac_pf_symmetries/cluster/nk/grids/case118_ieee.m
rm -rf "data/nk_tmp/k$k"
gridfm_datakit generate "$cfg"
src=data/nk_tmp/k$k/case118_ieee
mkdir -p "$dst"
mv "$src/raw" "$dst/raw"
cp "$cfg" "$dst/config.yaml"
[ -f "$dst/raw/n_scenarios.txt" ] || python - "$dst/raw" <<'PY'
import sys
import pyarrow.parquet as pq
from pathlib import Path
raw = Path(sys.argv[1])
p = raw / "bus_data.parquet"
files = [p] if p.is_file() else sorted(p.rglob("*.parquet"))
n = len({int(s) for f in files for s in pq.read_table(f, columns=["scenario"]).column(0).to_pylist()})
(raw / "n_scenarios.txt").write_text(f"{n}\n")
print("n_scenarios", n)
PY
cat "$dst/raw/n_scenarios.txt"
rm -rf "data/nk_tmp/k$k"
echo "NK_DONE k=$k $(du -sh "$dst" | cut -f1) $(date -Is)"
